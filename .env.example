# Copy this file to `.env` and fill in your Backpack Exchange API credentials.
# Used by the test suite (loaded via dotenv in jest.config.js) so that
# private-endpoint integration tests can authenticate against the live API.
# The real `.env` file is gitignored.
BPX_API_KEY=your-api-key
BPX_API_SECRET=your-api-secret

# Websocket tests: how long to wait for a live stream message before giving up (ms).
# Low-frequency streams (liquidation, stockPrice outside market hours,
# balanceUpdate) often receive nothing — those tests still pass and simply skip
# the payload assertions. Default: 10000.
BPX_WS_WAIT_MS=10000
